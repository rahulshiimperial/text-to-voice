<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>AI Voice Generator</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f4f6f8;
      color: #333;
      padding: 40px;
      display: flex;
      justify-content: center;
    }

    .container {
      background: #fff;
      padding: 30px 40px;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
      width: 100%;
      max-width: 600px;
    }

    h1 {
      text-align: center;
      margin-bottom: 30px;
      font-size: 28px;
      color: #2c3e50;
    }

    label {
      font-weight: 600;
      display: block;
      margin-top: 20px;
      margin-bottom: 8px;
    }

    select, textarea, button {
      width: 100%;
      padding: 12px;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 16px;
      box-sizing: border-box;
    }

    textarea {
      resize: vertical;
      min-height: 100px;
    }

    button {
      background-color: #007bff;
      color: #fff;
      margin-top: 20px;
      border: none;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    button:hover {
      background-color: #0056b3;
    }

    .audio-container {
      margin-top: 30px;
      text-align: center;
    }

    audio {
      margin-top: 10px;
      width: 100%;
    }

    a.download-link {
      display: inline-block;
      margin-top: 15px;
      padding: 10px 20px;
      background: #28a745;
      color: #fff;
      text-decoration: none;
      border-radius: 6px;
      transition: background 0.3s ease;
    }

    a.download-link:hover {
      background: #1e7e34;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>🎙️ AI Voice Generator</h1>

    <form action="/generate" method="POST">
      <label for="voiceId">Select a Voice</label>
      <select name="voiceId" id="voiceId" required>
        <% voices.forEach(voice => { %>
          <option value="<%= voice.voiceId %>"><%= voice.name %></option>
        <% }); %>
      </select>

      <label for="text">Type something to convert into speech</label>
      <textarea name="text" id="text" placeholder="Type your text here..." required></textarea>

      <button type="submit">Generate Speech</button>
    </form>

    <% if (audioUrl) { %>
      <div class="audio-container">
        <h2>🔊 Your Generated Voice</h2>
        <audio controls>
          <source src="<%= audioUrl %>" type="audio/mpeg">
          Your browser does not support the audio element.
        </audio>
        <br>
        <a class="download-link" href="<%= audioUrl %>" download="voice.mp3">Download Voice</a>
      </div>
    <% } %>
  </div>
</body>
</html>
